        <mxCell id="e_bottom_s3" style="endArrow=classicThin;html=1;strokeColor=#b85450;strokeWidth=2.5;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ac_bottom" target="s3_strip">
