        <mxCell id="pi_strip" value="&lt;b&gt;Pi Rack&lt;/b&gt;&#10;(left-wall rack)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=center;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
