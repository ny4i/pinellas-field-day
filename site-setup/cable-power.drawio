          <mxGeometry x="300" y="320" width="220" height="280" as="geometry" />
        </mxCell>
        <mxCell id="vhf_strip_load" value="• &lt;b&gt;FT-897 power supply&lt;/b&gt;&#10;• Anything else Paul brings&#10;&#10;&lt;i&gt;Owned and configured by Paul KC4YDY. Plug into the station's power strip; specifics are Paul's call.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="200" height="230" as="geometry" />
