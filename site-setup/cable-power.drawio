        </mxCell>
        <mxCell id="pi_strip_load" value="• &lt;b&gt;UPS&lt;/b&gt; (plugs into strip)&#10;• &lt;b&gt;Pi 400&lt;/b&gt; — protected by UPS&#10;• &lt;b&gt;Linksys router&lt;/b&gt; — protected by UPS&#10;&#10;&lt;i&gt;The Linksys router broadcasts the TRLOG SSID (WiFi 10.0.0.0/24 for laptops) and provides the wired 192.168.0.0/24 LAN that the Pi 400 connects to via Ethernet.&lt;/i&gt;&#10;&#10;&lt;i&gt;Both critical infrastructure devices are behind the UPS — everything else on the network depends on them.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingRight=12;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="200" height="230" as="geometry" />
        </mxCell>

